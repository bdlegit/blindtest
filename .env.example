# URL et clé PUBLIQUE de Supabase (utilisées aussi par le navigateur pour le temps réel)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
